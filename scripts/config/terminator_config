[global_config]
  suppress_multiple_term_dialog = True
[keybindings]
  broadcast_off = <Primary><Shift>h
  broadcast_all = <Primary><Shift>a
[profiles]
  [[default]]
    scrollback_lines = 5000
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
  [[GazeboLayout]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[split_horiz]]]
      type = HPaned
      parent = window0
    [[[split_vert_left]]]
      type = VPaned
      parent = split_horiz
      order = 0
    [[[split_vert_right]]]
      type = VPaned
      parent = split_horiz
      order = 1
    # Left column, top to bottom: terminal0 / terminal1 / terminal2 / terminal3
    [[[terminal0]]]
      type = Terminal
      parent = split_vert_left
      order = 0
      title = Camera Input & Params
    [[[split_vert_left_2]]]
      type = VPaned
      parent = split_vert_left
      order = 1
    [[[terminal1]]]
      type = Terminal
      parent = split_vert_left_2
      order = 0
      title = Camera Understortion
    [[[split_vert_left_3]]]
      type = VPaned
      parent = split_vert_left_2
      order = 1
    [[[terminal2]]]
      type = Terminal
      parent = split_vert_left_3
      order = 0
      title = Scratch 1
    [[[terminal3]]]
      type = Terminal
      parent = split_vert_left_3
      order = 1
      title = Scratch 2
    # Right column, top to bottom: terminal4 / terminal5 / terminal6 / terminal7
    [[[terminal4]]]
      type = Terminal
      parent = split_vert_right
      order = 0
      title = Depth Logic
    [[[split_vert_right_2]]]
      type = VPaned
      parent = split_vert_right
      order = 1
    [[[terminal5]]]
      type = Terminal
      parent = split_vert_right_2
      order = 0
      title = System Logs
    [[[split_vert_right_3]]]
      type = VPaned
      parent = split_vert_right_2
      order = 1
    [[[terminal6]]]
      type = Terminal
      parent = split_vert_right_3
      order = 0
      title = Teleop UI
    [[[terminal7]]]
      type = Terminal
      parent = split_vert_right_3
      order = 1
      title = Scratch 3
[plugins]
