{
  // --- C++ Settings ---
  "C_Cpp.default.includePath": [
    "/opt/ros/jazzy/include/**",
    "${workspaceFolder}/install/**/include/**",
    "${workspaceFolder}/src/**"
  ],
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.intelliSenseEngine": "default",
  // Αυτό είναι πολύ σωστό, αρκεί να έχεις τρέξει το make build μια φορά
  "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
  // --- ROS 2 Specific ---
  "ros.distro": "jazzy",
  // --- CMake ---
  "cmake.sourceDirectory": "${workspaceFolder}",
  "cmake.ignoreCMakeListsMissing": true,
  // --- Editor Comfort ---
  "editor.formatOnSave": true,
  // --- Python Settings ---
  // The .venv stays the default interpreter for the rest of the workspace.
  // gripper_manager.py itself runs with /usr/bin/python3 (see its shebang);
  // its gz imports resolve for Pylance through extraPaths below.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.extraPaths": [
    "/usr/lib/python3/dist-packages", // gz.transport13, gz.msgs10 (apt: python3-gz-*)
    "/opt/ros/jazzy/lib/python3.12/site-packages",
    "/opt/ros/jazzy/local/lib/python3.12/dist-packages",
    "${workspaceFolder}/install/shared_msgs/lib/python3.12/site-packages",
    "${workspaceFolder}/install/custom_msgs/lib/python3.12/site-packages",
    "${workspaceFolder}/install/local/lib/python3.12/dist-packages",
    "${workspaceFolder}/src",
    "${workspaceFolder}/external"
  ],
  "python.analysis.typeCheckingMode": "basic", // ΕΝΕΡΓΟΠΟΙΗΣΗ ΓΙΑ SYNTAX ERRORS
  // Προσθήκη για να βλέπεις τα λάθη σε πραγματικό χρόνο
  "python.analysis.diagnosticMode": "workspace",
  // Protobuf-generated classes (gz.msgs10.*_pb2) create their attributes at
  // runtime, so Pylance flags Entity.MODEL, req.plugins.add(), ... as unknown.
  "python.analysis.diagnosticSeverityOverrides": {
    "reportAttributeAccessIssue": "warning"
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "black-formatter.args": [
    "--line-length=200"
  ],
  // --- Terminal ---
  // Previously declared twice; the second declaration silently replaced the
  // first, dropping PYTHONPATH. Merged into one.
  "terminal.integrated.env.linux": {
    "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}/external:${env:PYTHONPATH}",
    "GTK_PATH": null
  },
  // --- Files ---
  "files.exclude": {
    "build/": true,
    "install/": true,
    "log/": true,
    "**/__pycache__": true,
    "**/*.pyc": true
  },
  "search.exclude": {
    "**/build/**": true,
    "**/install/**": true,
    "**/log/**": true
  },
  "files.watcherExclude": {
    "**/build/**": true,
    "**/install/**": true,
    "**/log/**": true
  }
}