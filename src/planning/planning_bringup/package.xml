<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>planning_bringup</name>
  <version>0.0.0</version>
  <description>cuMotion planner bringup for group_a (URDF/XRDF, params, launch)</description>
  <maintainer email="kaipismike1@gmail.com">kaipis</maintainer>
  <license>TODO: License declaration</license>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <depend>depth_image_proc</depend>
  <!-- launch/cumotion.launch.py -->
  <exec_depend>isaac_ros_cumotion</exec_depend>
  <exec_depend>group_a_description</exec_depend>
  <exec_depend>launch_param_builder</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <!-- collision_scene.py: static cuMotion world generated from layout.py -->
  <exec_depend>workcell_bringup</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>