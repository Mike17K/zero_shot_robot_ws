<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>workcell_demo</name>
  <version>0.1.0</version>
  <description>Workcell orchestrator: high-level behaviours on top of navigation, gripper and the feeding line (first: the infeed pick and place cycle)</description>
  <maintainer email="kaipismike1@gmail.com">kaipis</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>custom_msgs</exec_depend>
  <exec_depend>shared_utils</exec_depend>
  <exec_depend>navigator_cli</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
