<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>workcell_teleop</name>
  <version>0.0.1</version>
  <description>PyQt teleoperation UI: robot joint-position sliders and conveyor speed sliders</description>
  <maintainer email="kaipismike1@gmail.com">kaipis</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>trajectory_msgs</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>ament_index_python</depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- Not a hard build dependency (joint_limits.yaml is read from its share
       dir at RUNTIME via ament_index, not imported), but this is what has
       to actually be installed for the default joint_limits_package param
       to resolve - see teleop_gui.py's _load_joint_limits(). -->
  <exec_depend>group_a_moveit_config</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
