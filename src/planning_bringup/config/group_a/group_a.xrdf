format: xrdf
format_version: 1.0

modifiers:
  # The global or parent anchor for the whole moving system
  - set_base_frame: "gp_base_link"

default_joint_positions:
  gp_joint_1: 0.0
  gp_joint_2: -0.349066
  gp_joint_3: 0.349066
  gp_joint_4: 0.0
  gp_joint_5: -0.523599
  gp_joint_6: 0.0

cspace:
  joint_names:
    - "gp_joint_1"
    - "gp_joint_2"
    - "gp_joint_3"
    - "gp_joint_4"
    - "gp_joint_5"
    - "gp_joint_6"
  # Rough, conservative defaults (not vendor-specified, unlike the position/
  # velocity limits in group_a_moveit_config/config/joint_limits.yaml, which
  # DO come from motoman_gp70l_support/urdf/gp70l_macro.xacro).
  acceleration_limits: [6.0, 6.0, 6.0, 6.0, 6.0, 6.0]
  jerk_limits: [200.0, 200.0, 200.0, 200.0, 200.0, 200.0]

tool_frames: ["gripper_tcp"]

collision:
  geometry: "combined_robot_collision_spheres"
  buffer_distance:
    gp_base_link: 0.02
    gp_link_1: 0.02
    gp_link_2: 0.02
    gp_link_3: 0.02
    gp_link_4: 0.02
    gp_link_5: 0.02
    gp_link_6: 0.02
    gp_tool0: 0.01
    gripper_plate_link: 0.02
    camera_link: 0.01
    gripper_tcp: 0.0

self_collision:
  geometry: "combined_robot_collision_spheres"
  buffer_distance:
    gp_link_1: 0.07
    gp_tool0: 0.05
    gripper_plate_link: 0.02
  ignore:
    # Adjacent-link ignores, matching combined_system.srdf.xacro's
    # disable_collisions entries.
    gp_base_link: ["gp_link_1"]
    gp_link_1: ["gp_link_2"]
    gp_link_2: ["gp_link_3"]
    gp_link_3: ["gp_link_4"]
    gp_link_4: ["gp_link_5"]
    gp_link_5: ["gp_link_6"]
    gp_link_6: ["gp_tool0"]
    gp_tool0: ["gripper_plate_link"]
    gripper_plate_link:
      [
        "camera_link",
        "gripper_tcp",
        "suction_cup_1_link", "suction_cup_2_link", "suction_cup_3_link",
        "suction_cup_4_link", "suction_cup_5_link", "suction_cup_6_link",
        "suction_cup_7_link", "suction_cup_8_link", "suction_cup_9_link",
        "suction_cup_10_link", "suction_cup_11_link", "suction_cup_12_link",
      ]

geometry:
  combined_robot_collision_spheres:
    # Placeholder spheres interpolated straight-line along each link's own
    # joint-to-joint offset (from motoman_gp70l_support/urdf/gp70l_macro.xacro's
    # <origin> values) with a hand-guessed radius per link, NOT fitted against
    # the vendored collision meshes
    # (motoman_gp70l_support/meshes/gp70l/collision/link_*.stl) - same
    # approximation style the previous UR-based version of this file used.
    # Tighten these against the real meshes before trusting close-clearance
    # planning around the conveyor belts.
    spheres:
      gp_base_link:
        - center: [0.0, 0.0, 0.0]
          radius: 0.24
        - center: [0.0, 0.0, 0.27]
          radius: 0.24
        - center: [0.0, 0.0, 0.54]
          radius: 0.24
      gp_link_1:
        - center: [0.0, 0.0, 0.0]
          radius: 0.22
        - center: [0.32, 0.0, 0.0]
          radius: 0.22
      gp_link_2:
        - center: [0.0, 0.0, 0.0]
          radius: 0.15
        - center: [0.0, 0.0, 0.233]
          radius: 0.15
        - center: [0.0, 0.0, 0.466]
          radius: 0.15
        - center: [0.0, 0.0, 0.699]
          radius: 0.15
        - center: [0.0, 0.0, 0.932]
          radius: 0.15
        - center: [0.0, 0.0, 1.165]
          radius: 0.15
      gp_link_3:
        - center: [0.0, 0.0, 0.0]
          radius: 0.13
        - center: [0.245, 0.0, 0.047]
          radius: 0.13
        - center: [0.49, 0.0, 0.094]
          radius: 0.13
        - center: [0.735, 0.0, 0.141]
          radius: 0.13
        - center: [0.98, 0.0, 0.188]
          radius: 0.13
        - center: [1.225, 0.0, 0.235]
          radius: 0.13
      gp_link_4:
        - center: [0.0, 0.0, 0.0]
          radius: 0.12
      gp_link_5:
        - center: [0.0, 0.0, 0.0]
          radius: 0.10
      gp_link_6:
        - center: [0.0, 0.0, 0.0]
          radius: 0.09
        - center: [0.175, 0.0, 0.0]
          radius: 0.09
      gp_tool0:
      # 2x3 grid covering the gripper_plate_link footprint (0.30 x 0.40 x
      # 0.02, see group_a_description/urdf/group_a_macro.xacro) plus the
      # suction cups' protrusion (up to z=0.05 in the plate's own frame) -
      # one generous radius per sphere rather than a sphere per cup (12 more
      # spheres would be well within this coverage anyway for planning
      # purposes; tighten against real geometry if that stops being true).
      gripper_plate_link:
        - center: [-0.075, -0.133, 0.025]
          radius: 0.09
        - center: [0.075, -0.133, 0.025]
          radius: 0.09
        - center: [-0.075, 0.0, 0.025]
          radius: 0.09
        - center: [0.075, 0.0, 0.025]
          radius: 0.09
        - center: [-0.075, 0.133, 0.025]
          radius: 0.09
        - center: [0.075, 0.133, 0.025]
          radius: 0.09
      camera_link:
      gripper_tcp:
