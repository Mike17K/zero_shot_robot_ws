<?xml version="1.0" encoding="UTF-8"?>
<!-- SRDF for the combined system
    manualy converted from the original SRDF file generated by MoveIt Setup Assistant from
group_a_moveit_config package. The original file is located at:
    src/robots/group_a/group_a_moveit_config/config/combined_system.srdf

    Bare frame/link names on purpose - see group_a_description/urdf/group_a_macro.xacro's
    namespace-strategy comment. Multi-robot disambiguation is done by each robot's
    move_group instance running in its own ROS namespace with its own private
    robot_description_semantic parameter, not by baking a namespace into frame text.

    Link/joint names (gp_base_link, gp_link_1..gp_link_6, gp_flange, gp_tool0) come
    from motoman_gp70l_support/urdf/gp70l_macro.xacro's own link list, instantiated
    with prefix="gp_" - see group_a_description/urdf/group_a_macro.xacro. The
    disable_collisions entries below are hand-written adjacent-pair defaults (this
    workspace has no MoveIt Setup Assistant collision-matrix run against the real
    GP70L meshes) - re-run Setup Assistant's "Self-Collisions" step against the
    actual collision meshes if these need tightening.
-->
<robot xmlns:xacro="http://ros.org/xacro" name="combined_system">

    <group name="manipulator">
        <chain base_link="gp_base_link" tip_link="gp_tool0" />
    </group>
    <!--VIRTUAL
    JOINT: Purpose: this element defines a virtual joint between a robot link and an external frame
    of reference (considered fixed with respect to the robot)-->
    <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="gp_base_link" />
    <!--DISABLE
    COLLISIONS: By default it is assumed that any link of the robot could potentially come into
    collision with any other link in the robot. This tag disables collision checking between a
    specified pair of links. -->
    <disable_collisions link1="gp_base_link" link2="gp_link_1" reason="Adjacent" />
    <disable_collisions link1="gp_link_1" link2="gp_link_2" reason="Adjacent" />
    <disable_collisions link1="gp_link_2" link2="gp_link_3" reason="Adjacent" />
    <disable_collisions link1="gp_link_3" link2="gp_link_4" reason="Adjacent" />
    <disable_collisions link1="gp_link_4" link2="gp_link_5" reason="Adjacent" />
    <disable_collisions link1="gp_link_5" link2="gp_link_6" reason="Adjacent" />
    <disable_collisions link1="gp_link_6" link2="gp_flange" reason="Adjacent" />
    <disable_collisions link1="gp_flange" link2="gp_tool0" reason="Adjacent" />
    <disable_collisions link1="gp_link_6" link2="gp_tool0" reason="Never" />
    <disable_collisions link1="camera_link" link2="gp_link_6" reason="Adjacent" />
    <disable_collisions link1="camera_link" link2="gp_flange" reason="Adjacent" />
    <disable_collisions link1="camera_link" link2="gp_tool0" reason="Adjacent" />
    <!-- Non-adjacent but geometrically close pairs on a bent arm - kept
         disabled to match the previous UR-based SRDF's intent (avoid
         false-positive self-collision on the wrist/forearm links closest to
         the tool); re-enable and let MoveIt check them if that turns out to
         be too permissive for GP70L's actual link geometry. -->
    <disable_collisions link1="gp_link_3" link2="gp_link_5" reason="Never" />
    <disable_collisions link1="gp_link_4" link2="gp_link_6" reason="Never" />

</robot>
