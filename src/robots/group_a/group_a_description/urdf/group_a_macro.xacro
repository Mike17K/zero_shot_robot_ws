<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="group_a_robot"
        params="
        parent
        namespace=''
        sim_gazebo='true'
        use_fake_hardware='false'
        simulation_controllers='$(find group_a_bringup)/config/controllers.yaml'
        *origin"
    >

        <!-- ── Namespace strategy: topic namespacing, NOT frame-name prefixing ────
             Link/joint names below are bare (gp_base_link, camera_link, ...) -
             they are NOT built from ${namespace}. Multi-robot disambiguation
             comes entirely from each robot's nodes (robot_state_publisher,
             gz_ros2_control, move_group, the gz bridge) running within their
             own ROS namespace and publishing to their own /<namespace>/tf
             topic - the same strategy used by agv_description/agv_macro.xacro
             in the sibling internal_delivery_system_ws workspace.
             ${namespace} is still used below, but only for the things it's
             actually for: scoping gz_ros2_control's own nodes/topics and the
             camera sensor topics to this robot's ROS namespace - never to
             build a frame or link name.
             "gp_" / "camera_" below are permanent, literal name prefixes
             (organizational, distinguishing the arm's links from the camera's)
             - not per-instance template variables, same as AGV's own literal
             "wheel_left_"/"caster_front_"/"lidar_" link names.
        ──────────────────────────────────────────────────────────────────────── -->

        <!-- === Includes ───────────────────────────────────────────────────────
             motoman_gp70l_support/motoman_resources are a sparse-checked-out
             submodule - see src/robots/motoman_ros2_support_packages and the
             README's Quickstart. Unlike ur_description's ur_macro.xacro, this
             vendor macro:
               - takes only `prefix` - no `parent`/`*origin` handling, so the
                 mount_joint below is ours to add (same as
                 conveyor_description's own mount_joint).
               - ships no <ros2_control> block at all, so that's ours to write
                 too (below), unlike UR's bundled ur_joint_control_description.
               - ships NO <inertial> on any link (visual/collision only) -
                 fine for MoveIt/visualization, fatal for Gazebo: sdformat's
                 urdf2sdf drops any link missing mass (and everything
                 downstream of it), so the arm never actually spawned as a
                 physical model. Using our own local
                 gp70l_macro_with_inertials.xacro instead of the submodule's
                 file - same macro/link/joint names, with placeholder
                 mass/inertia added. See that file's own header comment for
                 why this is a local fork rather than an edit to the
                 submodule.
             (common_materials.xacro, for the arm's visual color, is pulled in
             by that file itself - no separate include needed here.)
        ──────────────────────────────────────────────────────────────────────── -->
        <xacro:include filename="$(find group_a_description)/urdf/gp70l_macro_with_inertials.xacro" />

        <!-- === GP70L Arm ──────────────────────────────────────────────────────── -->
        <xacro:motoman_gp70l prefix="gp_" />

        <joint name="mount_joint" type="fixed">
            <parent link="${parent}" />
            <child link="gp_base_link" />
            <xacro:insert_block name="origin" />
        </joint>

        <!-- === ros2_control block ──────────────────────────────────────────────
             Position-controlled, like group_a's previous UR arm (matches a
             joint_trajectory_controller downstream) - GP70L's own joint
             limits (position/effort/velocity) already live on the <joint>
             elements gp70l_macro.xacro emitted above; MoveIt's own
             acceleration limits are supplied separately, in
             group_a_moveit_config/config/joint_limits.yaml.
        ──────────────────────────────────────────────────────────────────────── -->
        <ros2_control name="gp70l_hardware" type="system">
            <hardware>
                <xacro:if value="${sim_gazebo}">
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </xacro:if>
                <xacro:unless value="${sim_gazebo}">
                    <plugin>mock_components/GenericSystem</plugin>
                </xacro:unless>
            </hardware>
            <joint name="gp_joint_1">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
            <joint name="gp_joint_2">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
            <joint name="gp_joint_3">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
            <joint name="gp_joint_4">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
            <joint name="gp_joint_5">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
            <joint name="gp_joint_6">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
        </ros2_control>

        <!-- === Camera at GP70L end-effector ─────────────────────────────────────
             Link names: camera_link   (bare, literal)
             Parent:     gp_tool0      (bare, literal - GP70L's own
                          ROS-Industrial "all-zeros tool frame", same role
                          ur_tool0 played before)
        ──────────────────────────────────────────────────────────────────────── -->
        <link name="camera_link">
            <visual>
                <geometry>
                    <box size="0.040 0.095 0.030" />
                </geometry>
                <material name="dark_grey">
                    <color rgba="0.15 0.15 0.15 1.0" />
                </material>
            </visual>
            <collision>
                <geometry>
                    <box size="0.040 0.095 0.030" />
                </geometry>
            </collision>
            <inertial>
                <mass value="0.120" />
                <inertia ixx="0.000060" ixy="0.0" ixz="0.0"
                    iyy="0.000060" iyz="0.0" izz="0.000060" />
            </inertial>
        </link>

        <joint name="camera_joint" type="fixed">
            <parent link="gp_tool0" />
            <child link="camera_link" />
            <origin xyz="0 0 0.020" rpy="0 0 0" />
        </joint>

        <!-- Optical frame -->
        <link name="camera_optical_frame" />
        <joint name="camera_optical_joint" type="fixed">
            <parent link="camera_link" />
            <child link="camera_optical_frame" />
            <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
        </joint>

        <!-- === Gazebo-only blocks ──────────────────────────────────────────── -->
        <xacro:if value="${sim_gazebo}">
            <gazebo>
                <plugin filename="gz_ros2_control-system"
                    name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                    <ros>
                        <namespace>${namespace}</namespace>
                    </ros>
                    <parameters>${simulation_controllers}</parameters>
                </plugin>
            </gazebo>

            <gazebo>
                <plugin filename="libgz-sim-pose-publisher-system.so"
                    name="gz::sim::systems::PosePublisher">
                    <publish_link_pose>true</publish_link_pose>
                    <publish_nested_model_pose>true</publish_nested_model_pose>
                    <use_pose_vector_msg>true</use_pose_vector_msg>
                    <update_frequency>50</update_frequency>
                </plugin>
            </gazebo>

            <!-- Replace the single rgbd_camera sensor with two sensors: depth + rgb -->
            <gazebo reference="camera_link">
                <sensor name="depth_camera" type="depth_camera">
                    <camera>
                        <horizontal_fov>1.2120256</horizontal_fov>
                        <image>
                            <width>320</width>
                            <height>240</height>
                            <format>R_FLOAT32</format>
                        </image>
                        <clip>
                            <near>0.10</near>
                            <far>3.0</far>
                        </clip>
                        <optical_frame_id>camera_optical_frame</optical_frame_id>
                    </camera>
                    <always_on>1</always_on>
                    <update_rate>10</update_rate>
                    <visualize>false</visualize>
                    <topic>${namespace}/camera/depth</topic>
                </sensor>

                <sensor name="rgb_camera" type="camera">
                    <camera>
                        <horizontal_fov>1.2120256</horizontal_fov>
                        <image>
                            <width>320</width>
                            <height>240</height>
                            <format>R8G8B8</format>
                        </image>
                        <clip>
                            <near>0.10</near>
                            <far>3.0</far>
                        </clip>
                        <noise>
                            <type>gaussian</type>
                            <mean>0.0</mean>
                            <stddev>0.007</stddev>
                        </noise>
                        <optical_frame_id>camera_optical_frame</optical_frame_id>
                    </camera>
                    <always_on>1</always_on>
                    <update_rate>10</update_rate>
                    <visualize>false</visualize>
                    <topic>${namespace}/camera/color</topic>
                </sensor>
            </gazebo>
        </xacro:if>

    </xacro:macro>
</robot>
