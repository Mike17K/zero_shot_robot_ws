<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ── Suction gripper ──────────────────────────────────────────────────────
         Top-level (not nested) macros - same reason as
         conveyor_description/urdf/conveyor_macro.xacro's roller macros:
         xacro registers macros globally by name, so defining these INSIDE
         group_a_robot's body would re-declare them on every expansion.

         A flat rectangular plate mounted on gp_tool0 with a 3x4 grid of
         suction cups protruding from its outer face, all fixed (no per-cup
         actuation/attach-detach physics here - this is geometry only, a
         picking behavior would need something like Gazebo's DetachableJoint
         plugin toggled per-cup from a grasp controller, not built yet).
         The plate's own Z axis is NOT rotated relative to gp_tool0's, so
         "the direction the cups protrude" and "the direction gp_tool0's own
         Z axis points" are the same axis - camera_optical_joint below reuses
         that fact directly (see its own comment).
    ──────────────────────────────────────────────────────────────────────── -->
    <xacro:macro name="suction_cup" params="idx x y z radius length">
        <link name="suction_cup_${idx}_link">
            <visual>
                <geometry>
                    <cylinder radius="${radius}" length="${length}" />
                </geometry>
                <material name="cup_black">
                    <color rgba="0.05 0.05 0.05 1.0" />
                </material>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${radius}" length="${length}" />
                </geometry>
            </collision>
            <inertial>
                <!-- Tiny/negligible next to the plate or the arm - solid
                     cylinder inertia, m=0.01kg, kept non-zero/non-singular. -->
                <mass value="0.01" />
                <inertia
                    ixx="${0.01 * (3.0 * radius * radius + length * length) / 12.0}"
                    ixy="0.0" ixz="0.0"
                    iyy="${0.01 * (3.0 * radius * radius + length * length) / 12.0}"
                    iyz="0.0"
                    izz="${0.01 * 0.5 * radius * radius}" />
            </inertial>
        </link>
        <joint name="suction_cup_${idx}_joint" type="fixed">
            <parent link="gripper_plate_link" />
            <child link="suction_cup_${idx}_link" />
            <origin xyz="${x} ${y} ${z}" rpy="0 0 0" />
        </joint>
    </xacro:macro>

    <!-- Recursive: emits suction cup idx's link/joint, then idx+1, ..., up
         to and including `count`, laying them out on a cols x (count/cols)
         grid (row = (idx-1)//cols, col = (idx-1)%cols) - xacro has no
         native for-loop over XML content, so this is the same recursive-
         macro pattern conveyor_macro.xacro's conveyor_roller_chain uses for
         its (also runtime-computed) roller count. -->
    <xacro:macro name="suction_cup_grid"
        params="idx count cols col0_x row0_y col_spacing row_spacing cup_z radius length">
        <xacro:if value="${idx &lt;= count}">
            <xacro:property name="grid_row" value="${(idx - 1) // cols}" />
            <xacro:property name="grid_col" value="${(idx - 1) % cols}" />
            <xacro:suction_cup idx="${idx}"
                x="${col0_x + grid_col * col_spacing}"
                y="${row0_y + grid_row * row_spacing}"
                z="${cup_z}" radius="${radius}" length="${length}" />
            <xacro:suction_cup_grid idx="${idx + 1}" count="${count}" cols="${cols}"
                col0_x="${col0_x}" row0_y="${row0_y}"
                col_spacing="${col_spacing}" row_spacing="${row_spacing}"
                cup_z="${cup_z}" radius="${radius}" length="${length}" />
        </xacro:if>
    </xacro:macro>

    <xacro:macro name="group_a_robot"
        params="
        parent
        namespace=''
        sim_gazebo='true'
        use_fake_hardware='false'
        simulation_controllers='$(find group_a_bringup)/config/controllers.yaml'
        *origin"
    >

        <!-- ── Namespace strategy: topic namespacing, NOT frame-name prefixing ────
             Link/joint names below are bare (gp_base_link, camera_link, ...) -
             they are NOT built from ${namespace}. Multi-robot disambiguation
             comes entirely from each robot's nodes (robot_state_publisher,
             gz_ros2_control, move_group, the gz bridge) running within their
             own ROS namespace and publishing to their own /<namespace>/tf
             topic - the same strategy used by agv_description/agv_macro.xacro
             in the sibling internal_delivery_system_ws workspace.
             ${namespace} is still used below, but only for the things it's
             actually for: scoping gz_ros2_control's own nodes/topics and the
             camera sensor topics to this robot's ROS namespace - never to
             build a frame or link name.
             "gp_" / "camera_" below are permanent, literal name prefixes
             (organizational, distinguishing the arm's links from the camera's)
             - not per-instance template variables, same as AGV's own literal
             "wheel_left_"/"caster_front_"/"lidar_" link names.
        ──────────────────────────────────────────────────────────────────────── -->

        <!-- === Includes ───────────────────────────────────────────────────────
             motoman_gp70l_support/motoman_resources are a sparse-checked-out
             submodule - see src/robots/motoman_ros2_support_packages and the
             README's Quickstart. Unlike ur_description's ur_macro.xacro, this
             vendor macro:
               - takes only `prefix` - no `parent`/`*origin` handling, so the
                 mount_joint below is ours to add (same as
                 conveyor_description's own mount_joint).
               - ships no <ros2_control> block at all, so that's ours to write
                 too (below), unlike UR's bundled ur_joint_control_description.
               - ships NO <inertial> on any link (visual/collision only) -
                 fine for MoveIt/visualization, fatal for Gazebo: sdformat's
                 urdf2sdf drops any link missing mass (and everything
                 downstream of it), so the arm never actually spawned as a
                 physical model. Using our own local
                 gp70l_macro_with_inertials.xacro instead of the submodule's
                 file - same macro/link/joint names, with placeholder
                 mass/inertia added. See that file's own header comment for
                 why this is a local fork rather than an edit to the
                 submodule.
             (common_materials.xacro, for the arm's visual color, is pulled in
             by that file itself - no separate include needed here.)
        ──────────────────────────────────────────────────────────────────────── -->
        <xacro:include filename="$(find group_a_description)/urdf/gp70l_macro_with_inertials.xacro" />

        <!-- === GP70L Arm ──────────────────────────────────────────────────────── -->
        <xacro:motoman_gp70l prefix="gp_" />

        <joint name="mount_joint" type="fixed">
            <parent link="${parent}" />
            <child link="gp_base_link" />
            <xacro:insert_block name="origin" />
        </joint>

        <!-- === ros2_control block ──────────────────────────────────────────────
             Position-controlled, like group_a's previous UR arm (matches a
             joint_trajectory_controller downstream) - GP70L's own joint
             limits (position/effort/velocity) already live on the <joint>
             elements gp70l_macro.xacro emitted above; MoveIt's own
             acceleration limits are supplied separately, in
             group_a_moveit_config/config/joint_limits.yaml.
        ──────────────────────────────────────────────────────────────────────── -->
        <ros2_control name="gp70l_hardware" type="system">
            <hardware>
                <xacro:if value="${sim_gazebo}">
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </xacro:if>
                <xacro:unless value="${sim_gazebo}">
                    <plugin>mock_components/GenericSystem</plugin>
                </xacro:unless>
            </hardware>
            <joint name="gp_joint_1">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
            <joint name="gp_joint_2">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
            <joint name="gp_joint_3">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
            <joint name="gp_joint_4">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
            <joint name="gp_joint_5">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
            <joint name="gp_joint_6">
                <command_interface name="position" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
        </ros2_control>

        <!-- === Suction gripper at GP70L end-effector ─────────────────────────────
             gripper_plate_link: bare, literal name, parent gp_tool0 (GP70L's
             own ROS-Industrial "all-zeros tool frame", same role ur_tool0
             played before). No rotation on this mount joint - the plate's Z
             axis IS gp_tool0's Z axis (the tool's own approach direction),
             which is what lets camera_optical_joint below reuse the exact
             same rotation the old tool0-mounted camera used and still end
             up "facing the same way as the suction cups", just moved to the
             plate's edge instead of centered on tool0.
        ──────────────────────────────────────────────────────────────────────── -->
        <xacro:property name="gripper_plate_width" value="0.30" /> <!-- X, 3 cup columns -->
        <xacro:property name="gripper_plate_length" value="0.40" /> <!-- Y, 4 cup rows -->
        <xacro:property name="gripper_plate_thickness" value="0.02" /> <!-- Z -->
        <xacro:property name="cup_cols" value="3" />
        <xacro:property name="cup_rows" value="4" />
        <xacro:property name="cup_spacing" value="0.08" />
        <xacro:property name="cup_radius" value="0.02" />
        <xacro:property name="cup_length" value="0.03" />
        <xacro:property name="cup_col0_x" value="${-(cup_cols - 1) * cup_spacing / 2.0}" />
        <xacro:property name="cup_row0_y" value="${-(cup_rows - 1) * cup_spacing / 2.0}" />
        <!-- Cups protrude from the plate's outer (tool-facing) side, z=thickness,
             so a cup's own center sits half its length further out. -->
        <xacro:property name="cup_z" value="${gripper_plate_thickness + cup_length / 2.0}" />

        <link name="gripper_plate_link">
            <visual>
                <origin xyz="0 0 ${gripper_plate_thickness / 2.0}" rpy="0 0 0" />
                <geometry>
                    <box size="${gripper_plate_width} ${gripper_plate_length} ${gripper_plate_thickness}" />
                </geometry>
                <material name="dark_grey">
                    <color rgba="0.15 0.15 0.15 1.0" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 ${gripper_plate_thickness / 2.0}" rpy="0 0 0" />
                <geometry>
                    <box size="${gripper_plate_width} ${gripper_plate_length} ${gripper_plate_thickness}" />
                </geometry>
            </collision>
            <inertial>
                <mass value="1.5" />
                <origin xyz="0 0 ${gripper_plate_thickness / 2.0}" rpy="0 0 0" />
                <inertia
                    ixx="${1.5 * (gripper_plate_length * gripper_plate_length + gripper_plate_thickness * gripper_plate_thickness) / 12.0}"
                    ixy="0.0" ixz="0.0"
                    iyy="${1.5 * (gripper_plate_width * gripper_plate_width + gripper_plate_thickness * gripper_plate_thickness) / 12.0}"
                    iyz="0.0"
                    izz="${1.5 * (gripper_plate_width * gripper_plate_width + gripper_plate_length * gripper_plate_length) / 12.0}" />
            </inertial>
        </link>

        <joint name="gripper_mount_joint" type="fixed">
            <parent link="gp_tool0" />
            <child link="gripper_plate_link" />
            <origin xyz="0 0 0" rpy="0 0 0" />
        </joint>

        <!-- 3x4 = 12 suction cups, cols along X, rows along Y - see
             suction_cup_grid's own comment above. -->
        <xacro:suction_cup_grid idx="1" count="${cup_cols * cup_rows}" cols="${cup_cols}"
            col0_x="${cup_col0_x}" row0_y="${cup_row0_y}"
            col_spacing="${cup_spacing}" row_spacing="${cup_spacing}"
            cup_z="${cup_z}" radius="${cup_radius}" length="${cup_length}" />

        <!-- Tool-center-point: massless reference frame at the cup grid's
             own tip (centered in X/Y, at the cups' outer face) - what
             planning should actually target, since gp_tool0 now sits behind
             the whole plate+cup stack rather than at the gripper's working
             point. Used as planning_bringup/config/group_a/group_a.xrdf's
             tool_frames and combined_system.srdf.xacro's "manipulator"
             group's chain tip_link. -->
        <link name="gripper_tcp" />
        <joint name="gripper_tcp_joint" type="fixed">
            <parent link="gripper_plate_link" />
            <child link="gripper_tcp" />
            <origin xyz="0 0 ${cup_z + cup_length / 2.0}" rpy="0 0 0" />
        </joint>

        <!-- === Camera at the gripper's edge ───────────────────────────────────
             Off to one edge (max +Y, clear of the cup grid) and centered
             across the width (X=0) - "in the edge of the gripper, head down
             facing like the suction cups": same Z (protrusion) direction as
             the cups, just not in the middle of the array.

             camera_joint yaws the camera body 90° about Z first: the camera
             box is 0.040 x 0.095 (not square), and mounted at its default
             orientation its LONG (0.095) side would face along plate-Y -
             straight toward the cup grid's last row, with no room left to
             clear it inside a 0.40-long plate (checked: -2.5cm of actual
             overlap). Yawing about Z doesn't touch the Z axis itself, so it
             doesn't affect "which way the camera looks" (still gp_tool0's
             own Z, same as the cups) - it only swaps which box dimension
             faces the edge, so the SHORT (0.040) side does instead, needing
             far less edge clearance. -->
        <xacro:property name="cup_last_row_edge_y" value="${-cup_row0_y + cup_radius}" />
        <xacro:property name="camera_gap" value="0.02" /> <!-- clearance from the nearest cup -->
        <xacro:property name="camera_y" value="${cup_last_row_edge_y + camera_gap + 0.040 / 2.0}" />
        <xacro:property name="camera_z" value="${gripper_plate_thickness + 0.020}" />

        <link name="camera_link">
            <visual>
                <geometry>
                    <box size="0.040 0.095 0.030" />
                </geometry>
                <material name="dark_grey">
                    <color rgba="0.15 0.15 0.15 1.0" />
                </material>
            </visual>
            <collision>
                <geometry>
                    <box size="0.040 0.095 0.030" />
                </geometry>
            </collision>
            <inertial>
                <mass value="0.120" />
                <inertia ixx="0.000060" ixy="0.0" ixz="0.0"
                    iyy="0.000060" iyz="0.0" izz="0.000060" />
            </inertial>
        </link>

        <joint name="camera_joint" type="fixed">
            <parent link="gripper_plate_link" />
            <child link="camera_link" />
            <origin xyz="0 ${camera_y} ${camera_z}" rpy="0 0 ${pi/2}" />
        </joint>

        <!-- Optical frame - identical rotation to before: camera_link's own
             axes are still unrotated relative to its parent's (gp_tool0
             before, gripper_plate_link now), and that parent's Z axis is
             still gp_tool0's own Z axis either way, so this still points
             the optical Z axis the same direction as the suction cups. -->
        <link name="camera_optical_frame" />
        <joint name="camera_optical_joint" type="fixed">
            <parent link="camera_link" />
            <child link="camera_optical_frame" />
            <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
        </joint>

        <!-- === Gazebo-only blocks ──────────────────────────────────────────── -->
        <xacro:if value="${sim_gazebo}">
            <gazebo>
                <plugin filename="gz_ros2_control-system"
                    name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                    <ros>
                        <namespace>${namespace}</namespace>
                    </ros>
                    <parameters>${simulation_controllers}</parameters>
                </plugin>
            </gazebo>

            <!-- No grasping plugin is declared here on purpose. A
                 DetachableJoint declared in this URDF would have to name its
                 child model at BUILD time, which caps grasping at a fixed set
                 of pre-named objects and - because DetachableJoint defaults to
                 attached - welds each of those objects to this arm the instant
                 it spawns, wherever it happens to be in the world. Instead
                 group_a_bringup's gripper_manager.py installs a DetachableJoint
                 onto this model at RUNTIME, per object, via Gazebo's
                 /world/<world>/entity/system/add service - unlimited objects,
                 nothing baked in here. See that node's docstring. -->

            <gazebo>
                <plugin filename="libgz-sim-pose-publisher-system.so"
                    name="gz::sim::systems::PosePublisher">
                    <publish_link_pose>true</publish_link_pose>
                    <publish_nested_model_pose>true</publish_nested_model_pose>
                    <use_pose_vector_msg>true</use_pose_vector_msg>
                    <update_frequency>50</update_frequency>
                </plugin>
            </gazebo>

            <!-- Replace the single rgbd_camera sensor with two sensors: depth + rgb -->
            <gazebo reference="camera_link">
                <sensor name="depth_camera" type="depth_camera">
                    <camera>
                        <horizontal_fov>1.2120256</horizontal_fov>
                        <image>
                            <width>320</width>
                            <height>240</height>
                            <format>R_FLOAT32</format>
                        </image>
                        <clip>
                            <near>0.10</near>
                            <far>3.0</far>
                        </clip>
                        <optical_frame_id>camera_optical_frame</optical_frame_id>
                    </camera>
                    <always_on>1</always_on>
                    <update_rate>10</update_rate>
                    <visualize>false</visualize>
                    <topic>${namespace}/camera/depth</topic>
                </sensor>

                <sensor name="rgb_camera" type="camera">
                    <camera>
                        <horizontal_fov>1.2120256</horizontal_fov>
                        <image>
                            <width>320</width>
                            <height>240</height>
                            <format>R8G8B8</format>
                        </image>
                        <clip>
                            <near>0.10</near>
                            <far>3.0</far>
                        </clip>
                        <noise>
                            <type>gaussian</type>
                            <mean>0.0</mean>
                            <stddev>0.007</stddev>
                        </noise>
                        <optical_frame_id>camera_optical_frame</optical_frame_id>
                    </camera>
                    <always_on>1</always_on>
                    <update_rate>10</update_rate>
                    <visualize>false</visualize>
                    <topic>${namespace}/camera/color</topic>
                </sensor>
            </gazebo>
        </xacro:if>

    </xacro:macro>
</robot>
